{
  "name": "git4vs",
  "displayName": "git4vs",
  "description": "Brings IntelliJ IDEA's changelists and revision diff workflow to VS Code. Complements the built-in Git view and Git Graph+ rather than replacing them.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-prakapienka/git4vs.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "configuration": {
      "title": "git4vs",
      "properties": {
        "git4vs.changelists.autoAssignToActive": {
          "type": "boolean",
          "default": true,
          "description": "Newly modified files are automatically assigned to the active changelist."
        },
        "git4vs.changelists.persistIntervalMs": {
          "type": "number",
          "default": 4000,
          "description": "How often changelist contents are snapshotted into git objects (0 disables background snapshots)."
        },
        "git4vs.diff.openSideBySide": {
          "type": "boolean",
          "default": true,
          "description": "Open revision diffs in a side-by-side editor."
        },
        "git4vs.integration.gitGraphPlus": {
          "type": "boolean",
          "default": true,
          "description": "Delegate graph and branch actions to the Git Graph+ extension when it is installed."
        }
      }
    },
    "commands": [
      {
        "command": "git4vs.changelist.create",
        "title": "New Changelist",
        "category": "git4vs",
        "icon": "$(new-folder)"
      },
      {
        "command": "git4vs.changelist.rename",
        "title": "Rename Changelist",
        "category": "git4vs",
        "icon": "$(edit)"
      },
      {
        "command": "git4vs.changelist.delete",
        "title": "Delete Changelist",
        "category": "git4vs",
        "icon": "$(trash)"
      },
      {
        "command": "git4vs.changelist.setActive",
        "title": "Set Active Changelist",
        "category": "git4vs",
        "icon": "$(check)"
      },
      {
        "command": "git4vs.changelist.moveTo",
        "title": "Move to Changelist\u2026",
        "category": "git4vs",
        "icon": "$(arrow-right)"
      },
      {
        "command": "git4vs.changelist.commit",
        "title": "Commit Changelist",
        "category": "git4vs",
        "icon": "$(check-all)"
      },
      {
        "command": "git4vs.changelist.shelve",
        "title": "Shelve Changelist",
        "category": "git4vs",
        "icon": "$(archive)"
      },
      {
        "command": "git4vs.changelist.unshelve",
        "title": "Unshelve\u2026",
        "category": "git4vs",
        "icon": "$(inbox)"
      },
      {
        "command": "git4vs.changelist.rollback",
        "title": "Rollback Changelist",
        "category": "git4vs",
        "icon": "$(discard)"
      },
      {
        "command": "git4vs.changelist.refresh",
        "title": "Refresh Changelists",
        "category": "git4vs",
        "icon": "$(refresh)"
      },
      {
        "command": "git4vs.diff.withRevision",
        "title": "Compare with Revision\u2026",
        "category": "git4vs",
        "icon": "$(git-compare)"
      },
      {
        "command": "git4vs.diff.withBranch",
        "title": "Compare with Branch\u2026",
        "category": "git4vs"
      },
      {
        "command": "git4vs.diff.betweenRevisions",
        "title": "Compare Two Revisions\u2026",
        "category": "git4vs"
      },
      {
        "command": "git4vs.diff.changelist",
        "title": "Show Diff for Changelist",
        "category": "git4vs",
        "icon": "$(git-compare)"
      },
      {
        "command": "git4vs.diff.fileHistory",
        "title": "Show File History",
        "category": "git4vs",
        "icon": "$(history)"
      },
      {
        "command": "git4vs.vcs.update",
        "title": "Update Project (pull --rebase)",
        "category": "git4vs",
        "icon": "$(cloud-download)"
      },
      {
        "command": "git4vs.vcs.push",
        "title": "Push",
        "category": "git4vs",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "git4vs.vcs.openGraph",
        "title": "Show Git Log",
        "category": "git4vs",
        "icon": "$(graph)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "git4vs.changelists",
          "name": "Changelists",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "git4vs.changelist.create",
          "when": "view == git4vs.changelists",
          "group": "navigation@1"
        },
        {
          "command": "git4vs.vcs.update",
          "when": "view == git4vs.changelists",
          "group": "navigation@2"
        },
        {
          "command": "git4vs.vcs.push",
          "when": "view == git4vs.changelists",
          "group": "navigation@3"
        },
        {
          "command": "git4vs.vcs.openGraph",
          "when": "view == git4vs.changelists",
          "group": "navigation@4"
        },
        {
          "command": "git4vs.changelist.refresh",
          "when": "view == git4vs.changelists",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "git4vs.changelist.setActive",
          "when": "view == git4vs.changelists && viewItem =~ /^changelist\\\\./",
          "group": "inline@1"
        },
        {
          "command": "git4vs.changelist.commit",
          "when": "view == git4vs.changelists && viewItem =~ /^changelist\\\\./",
          "group": "1_commit@1"
        },
        {
          "command": "git4vs.diff.changelist",
          "when": "view == git4vs.changelists && viewItem =~ /^changelist\\\\./",
          "group": "1_commit@2"
        },
        {
          "command": "git4vs.changelist.shelve",
          "when": "view == git4vs.changelists && viewItem =~ /^changelist\\\\./",
          "group": "2_shelve@1"
        },
        {
          "command": "git4vs.changelist.rename",
          "when": "view == git4vs.changelists && viewItem == changelist.custom",
          "group": "3_edit@1"
        },
        {
          "command": "git4vs.changelist.delete",
          "when": "view == git4vs.changelists && viewItem == changelist.custom",
          "group": "4_danger@1"
        },
        {
          "command": "git4vs.changelist.rollback",
          "when": "view == git4vs.changelists && viewItem =~ /^changelist\\\\./",
          "group": "4_danger@2"
        },
        {
          "command": "git4vs.changelist.moveTo",
          "when": "view == git4vs.changelists && viewItem == changelistFile",
          "group": "1_move@1"
        },
        {
          "command": "git4vs.diff.withRevision",
          "when": "view == git4vs.changelists && viewItem == changelistFile",
          "group": "2_diff@1"
        },
        {
          "command": "git4vs.diff.fileHistory",
          "when": "view == git4vs.changelists && viewItem == changelistFile",
          "group": "2_diff@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "git4vs.changelist.moveTo",
          "when": "scmProvider == git",
          "group": "1_modification@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "git4vs.diff.withRevision",
          "group": "git4vs@1"
        },
        {
          "command": "git4vs.diff.fileHistory",
          "group": "git4vs@2"
        }
      ],
      "commandPalette": [
        {
          "command": "git4vs.changelist.rename",
          "when": "false"
        },
        {
          "command": "git4vs.changelist.delete",
          "when": "false"
        },
        {
          "command": "git4vs.changelist.setActive",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist-test/test/*.test.js",
    "pretest": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}